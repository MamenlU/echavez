PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=echavez_web_demo
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173

# Google Sign-In (backend OAuth verification)
GOOGLE_CLIENT_ID=

# PayMongo — required only for GCash/Card checkout.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Email — welcome email, forgot password, and Admin order notifications.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Rayjin Assistant — optional. Core system features work when disabled or unconfigured.
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_REQUEST_TIMEOUT_MS=12000
AI_AUTO_REPLY_ENABLED=false
