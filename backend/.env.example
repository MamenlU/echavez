PORT=5000
# Supabase PostgreSQL transaction-pooler URL (Connect > Transaction pooler).
# Keep the real URL in local/deployment secrets; never commit it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
DB_POOL_MAX=1
# Server-only Supabase Storage credentials. Never expose the service-role key to Vite/browser code.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173

# Google Sign-In (backend OAuth verification)
GOOGLE_CLIENT_ID=

# PayMongo — required only for GCash/Card checkout.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Email — welcome email, forgot password, and Admin order notifications.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Rayjin Assistant — optional. Core system features work when disabled or unconfigured.
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_REQUEST_TIMEOUT_MS=12000
AI_AUTO_REPLY_ENABLED=false
